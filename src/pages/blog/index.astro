---
import { type CollectionEntry, getCollection } from "astro:content";
import Layout from "@layouts/Layout.astro";
import Container from "@components/Container.astro";
import Link from "@components/Link.astro";
import { BLOG } from "@consts";

const data = (await getCollection("blog"))
  .filter((post) => !post.data.draft)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

type Acc = {
  [year: string]: CollectionEntry<"blog">[];
};

const posts = data.reduce((acc: Acc, post) => {
  const year = post.data.date.getFullYear().toString();
  if (!acc[year]) {
    acc[year] = [];
  }
  acc[year].push(post);
  return acc;
}, {});

const years = Object.keys(posts).sort((a, b) => parseInt(b) - parseInt(a));

function formatDate(date: Date): string {
  return date.toLocaleDateString("en-US", {
    month: "short",
    day: "2-digit",
  });
}
---

<Layout title={BLOG.TITLE} description={BLOG.DESCRIPTION}>
  <Container>
    <div>
      <div>
        <h1 class="page-title mt-4 mb-[22px]">Blog</h1>
        <p class="text-body max-w-[560px] text-[17px] leading-[1.7]">
          Engineering notes, travel stories, and thoughts on everyday life.
          Browse the archive or explore a <Link href="/tags" class="text-accent"
            >topic</Link
          >.
        </p>
      </div>

      <div class="mt-6 flex flex-wrap items-center gap-x-6 gap-y-3">
        <nav
          aria-label="Filter posts by topic"
          class="flex flex-wrap gap-2 text-sm"
        >
          {
            [
              ["all", "All"],
              ["engineering", "Engineering"],
              ["travel", "Travel"],
              ["life", "Life"],
            ].map(([value, label]) => (
              <a
                href={`?topic=${value}#posts-container`}
                data-topic={value}
                class="topic-filter text-body hover:bg-surface rounded-md px-3 py-2"
              >
                {label}
              </a>
            ))
          }
        </nav>
        <button
          data-search-open
          aria-haspopup="dialog"
          aria-controls="search-dialog"
          class="text-accent py-2 text-sm underline underline-offset-4 hover:decoration-ink"
          >Search posts</button
        >
      </div>
      <p id="filter-status" class="sr-only" role="status"></p>
      <div id="posts-container">
        {
          years.map((year) => (
            <section data-year={year}>
              <div class="bg-border mt-10 h-px" />
              <h2 class="text-ink mt-11 mb-1 text-[22px] font-bold">
                {year}{" "}
                <span class="text-muted font-normal">
                  ({posts[year].length})
                </span>
              </h2>
              <ul>
                {posts[year].map((post) => (
                  <li
                    class="post-item"
                    data-tags={post.data.tags?.join(",") || ""}
                  >
                    <a
                      href={`/blog/${post.id}`}
                      class="border-border hover:bg-surface2 -mx-3.5 grid gap-2 rounded-[10px] border-b px-3.5 py-[19px] transition-colors sm:grid-cols-[1fr_auto] sm:items-baseline sm:gap-[22px]"
                    >
                      <span class="text-ink text-[18px] leading-[1.3] font-semibold">
                        {post.data.title}
                      </span>
                      <span class="text-muted font-mono text-[13px] whitespace-nowrap tabular-nums">
                        {formatDate(post.data.date)}
                      </span>
                    </a>
                  </li>
                ))}
              </ul>
            </section>
          ))
        }
      </div>
    </div>
  </Container>
</Layout>

<style>
  .topic-filter[aria-current="true"] {
    background: var(--surface);
    color: var(--text);
  }
</style>
<script>
  function setupTopics() {
    const container = document.getElementById("posts-container");
    if (!container) return;
    const engineering = new Set([
      "programming",
      "distributed-systems",
      "dev-setup",
      "machine-learning",
      "side-project",
      "docker",
      "aws",
      "python",
      "go",
      "javascript",
      "AI",
    ]);
    function filter(topic: string) {
      let total = 0;
      container!
        .querySelectorAll<HTMLElement>("[data-year]")
        .forEach((section) => {
          let visible = 0;
          section
            .querySelectorAll<HTMLElement>(".post-item")
            .forEach((post) => {
              const tags = (post.dataset.tags || "").split(",");
              const matches =
                topic === "all" ||
                (topic === "travel"
                  ? tags.includes("travel")
                  : topic === "life"
                    ? tags.includes("writing") ||
                      tags.every(
                        (tag) => !engineering.has(tag) && tag !== "travel",
                      )
                    : tags.some((tag) => engineering.has(tag)));
              post.hidden = !matches;
              if (matches) visible++;
            });
          section.hidden = visible === 0;
          const count = section.querySelector("h2 span");
          if (count) count.textContent = `(${visible})`;
          total += visible;
        });
      document
        .querySelectorAll<HTMLAnchorElement>("[data-topic]")
        .forEach((link) =>
          link.setAttribute(
            "aria-current",
            String(link.dataset.topic === topic),
          ),
        );
      const status = document.getElementById("filter-status");
      if (status) status.textContent = `${total} posts shown`;
    }
    const topic = new URLSearchParams(location.search).get("topic") || "all";
    filter(
      ["all", "engineering", "travel", "life"].includes(topic) ? topic : "all",
    );
    document
      .querySelectorAll<HTMLAnchorElement>("[data-topic]")
      .forEach((link) => {
        link.addEventListener("click", (event) => {
          if (event.metaKey || event.ctrlKey || event.shiftKey || event.altKey)
            return;
          event.preventDefault();
          const topic = link.dataset.topic || "all";
          const url = new URL(location.href);
          if (topic === "all") url.searchParams.delete("topic");
          else url.searchParams.set("topic", topic);
          history.replaceState(null, "", url);
          filter(topic);
        });
      });
  }
  document.addEventListener("astro:page-load", setupTopics);
</script>
