---
import Layout from "@layouts/Layout.astro";
import Container from "@components/Container.astro";
import { SITE, HOME, SOCIALS } from "@consts";
import { getCollection } from "astro:content";
const blog = (await getCollection("blog"))
  .filter((post) => !post.data.draft)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, SITE.NUM_POSTS_ON_HOMEPAGE);
const contacts = [
  ...SOCIALS.filter((social) => ["GitHub", "LinkedIn"].includes(social.NAME)),
  { NAME: "Email", HREF: `mailto:${SITE.EMAIL}` },
];
---

<Layout title={HOME.TITLE} description={HOME.DESCRIPTION}>
  <Container>
    <section aria-labelledby="intro-title" class="pt-4">
      <div
        class="flex flex-col-reverse items-start gap-7 sm:flex-row sm:justify-between sm:gap-10"
      >
        <div class="min-w-0 flex-1">
          <h1
            id="intro-title"
            class="text-ink text-[38px] leading-[1.08] font-bold tracking-[-0.04em] sm:text-[48px]"
          >
            Hello,<br />I'm Prabhat
          </h1>
          <div
            class="text-body mt-6 max-w-[430px] space-y-4 text-[17px] leading-[1.7]"
          >
            <p>
              I build software around ML infrastructure and backend systems.
              Here I share engineering notes, things I’m building, and stories
              from everyday life.
            </p>
            <p>
              Outside work, I'm usually cafe-hopping for good coffee, exploring
              somewhere new, or trying to keep life simple enough to pay
              attention.
            </p>
          </div>
          <ul class="mt-6 flex flex-wrap gap-x-6 gap-y-2 text-sm">
            {
              contacts.map((social) => (
                <li>
                  <a
                    href={social.HREF}
                    class="text-accent decoration-muted hover:text-accent hover:decoration-accent inline-block py-2 underline underline-offset-4"
                  >
                    {social.NAME}
                  </a>
                </li>
              ))
            }
          </ul>
        </div>
        <img
          src="/pks.jpeg"
          alt="Prabhat Kumar Sahu"
          width="208"
          height="248"
          class="h-24 w-24 shrink-0 rounded-xl object-cover object-top sm:h-[220px] sm:w-[180px]"
        />
      </div>
    </section>
    <section aria-labelledby="writing-title" class="mt-14">
      <div
        class="border-border flex items-center justify-between border-b pb-3"
      >
        <h2 id="writing-title" class="section-label">Latest writing</h2>
        <a
          href="/blog"
          class="text-accent text-sm underline underline-offset-4 hover:decoration-ink"
          >All posts <span aria-hidden="true">→</span></a
        >
      </div>
      <ul>
        {
          blog.map((post) => (
            <li class="border-border border-b">
              <a
                href={`/blog/${post.id}`}
                class="hover:bg-surface2 -mx-3 grid gap-2 rounded-lg px-3 py-5 transition-colors sm:grid-cols-[1fr_auto] sm:items-baseline sm:gap-6"
              >
                <span class="text-ink text-lg leading-snug font-semibold">
                  {post.data.title}
                </span>
                <time
                  datetime={post.data.date.toISOString()}
                  class="text-muted font-mono text-xs whitespace-nowrap"
                >
                  {post.data.date.toLocaleDateString("en-US", {
                    year: "numeric",
                    month: "short",
                    day: "2-digit",
                    timeZone: "UTC",
                  })}
                </time>
              </a>
            </li>
          ))
        }
      </ul>
    </section>
  </Container>
</Layout>
