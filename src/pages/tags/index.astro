---
import { getCollection } from "astro:content";
import Layout from "@layouts/Layout.astro";
import Container from "@components/Container.astro";
import BackToPrevious from "@components/BackToPrevious.astro";

const posts = await getCollection("blog", ({ data }) => !data.draft);
const tags = [...new Set(posts.flatMap((post) => post.data.tags || []))].sort();
---

<Layout title="Tags" description="List of tags used.">
  <Container>
    <div class="space-y-10">
      <BackToPrevious href="/blog">Back to blog</BackToPrevious>
      <h1 class="page-title">All Tags</h1>
      <div class="flex flex-wrap gap-2">
        {
          tags.map((tag) => (
            <a
              href={`/tags/${tag}`}
              class="border-border hover:bg-surface hover:text-accent focus-visible:bg-surface focus-visible:text-accent rounded-md border px-2 py-1 text-sm transition-colors duration-300 ease-in-out"
            >
              {tag}{" "}
              <span class="text-muted text-sm">
                ({posts.filter((post) => post.data.tags?.includes(tag)).length})
              </span>
            </a>
          ))
        }
      </div>
    </div>
  </Container>
</Layout>
