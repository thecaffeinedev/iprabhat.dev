---
import type { CollectionEntry } from "astro:content";
type Props = { entry: CollectionEntry<"blog"> | CollectionEntry<"projects"> };
const { entry } = Astro.props;
---

<a
  href={`/${entry.collection}/${entry.id}`}
  class="not-prose group border-border text-body hover:text-accent block border-b py-5 transition-colors"
>
  <div
    class="text-ink group-hover:text-accent text-lg leading-snug font-semibold"
  >
    {entry.data.title}
  </div>
  <p class="text-body mt-2 text-[15px] leading-relaxed">
    {entry.data.description}
  </p>
</a>
