---
const { prevPost, nextPost } = Astro.props;
---

<nav
  data-pagefind-ignore
  aria-label="More posts"
  class="border-border grid gap-4 border-t pt-6 sm:grid-cols-2 sm:gap-8"
>
  {
    prevPost?.id && (
      <a
        href={`/blog/${prevPost.id}`}
        class="hover:text-accent rounded-md py-2"
      >
        <>
          <span class="text-muted block text-xs">← Newer post</span>
          <span class="mt-2 block text-base leading-relaxed">
            {prevPost.data.title}
          </span>
        </>
      </a>
    )
  }
  {
    nextPost?.id && (
      <a
        href={`/blog/${nextPost.id}`}
        class="hover:text-accent rounded-md py-2 sm:col-start-2"
      >
        <>
          <span class="text-muted block text-xs">Older post →</span>
          <span class="mt-2 block text-base leading-relaxed">
            {nextPost.data.title}
          </span>
        </>
      </a>
    )
  }
</nav>
