---
import { cn } from "@lib/utils";

type Props = {
  href: string;
  external?: boolean;
  underline?: boolean;
  group?: boolean;
  class?: string;
};

const {
  href,
  external,
  underline = true,
  group = false,
  class: className,
  ...rest
} = Astro.props;
---

<a
  href={href}
  target={external ? "_blank" : "_self"}
  rel={external ? "noopener noreferrer" : undefined}
  class={cn(
    "inline-block decoration-muted hover:decoration-accent focus-visible:decoration-accent text-current hover:text-accent focus-visible:text-accent transition-colors duration-150",
    underline && "underline underline-offset-[3px]",
    group && "group",
    className,
  )}
  {...rest}
>
  <slot />
</a>
