---
import Container from "@components/Container.astro";
import { SITE } from "@consts";
---

<footer data-pagefind-ignore>
  <Container>
    <div
      class="border-border text-muted flex flex-wrap items-center justify-between gap-5 border-t pt-6 text-sm"
    >
      <span>© {new Date().getFullYear()} {SITE.TITLE}</span>
      <button id="back-to-top" class="hover:text-accent py-2 text-sm"
        >Back to top <span aria-hidden="true">↑</span></button
      >
    </div>
  </Container>
</footer>
