---
import TableOfContentsHeading from "./TableOfContentsHeading.astro";
export interface Heading {
  depth: number;
  slug: string;
  text: string;
}
interface TocHeading extends Heading {
  subheadings: TocHeading[];
}
const { headings } = Astro.props as { headings: Heading[] };
const toc: TocHeading[] = [];
const stack: TocHeading[] = [];
for (const heading of headings.filter((heading) => heading.depth >= 2)) {
  const node: TocHeading = { ...heading, subheadings: [] };
  while (stack.length && stack[stack.length - 1].depth >= node.depth)
    stack.pop();
  if (stack.length) stack[stack.length - 1].subheadings.push(node);
  else toc.push(node);
  stack.push(node);
}
---

{
  headings.length >= 4 && (
    <details
      data-pagefind-ignore
      data-toc
      open
      class="not-prose border-border bg-surface2 my-8 rounded-lg border px-5 py-4"
    >
      <summary class="text-body cursor-pointer text-sm font-semibold">
        On this page
      </summary>
      <nav aria-label="Table of contents" class="mt-3">
        <ul>
          {toc.map((heading) => (
            <TableOfContentsHeading heading={heading} />
          ))}
        </ul>
      </nav>
    </details>
  )
}
<script>
  document.addEventListener("astro:page-load", () => {
    document
      .querySelectorAll<HTMLDetailsElement>("[data-toc]")
      .forEach((toc) => {
        toc.open = window.matchMedia("(min-width: 640px)").matches;
      });
  });
</script>
