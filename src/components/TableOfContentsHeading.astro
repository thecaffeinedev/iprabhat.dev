---
import type { Heading } from "./TableOfContents.astro";
interface TocHeading extends Heading {
  subheadings: TocHeading[];
}
const { heading } = Astro.props as { heading: TocHeading };
---

<li class="list-none">
  <a
    href={"#" + heading.slug}
    class="text-body hover:text-accent inline-block py-1.5 text-[15px] leading-relaxed"
    >{heading.text}</a
  >
  {
    heading.subheadings.length > 0 && (
      <ul class="border-border ml-4 border-l pl-4">
        {heading.subheadings.map((subheading) => (
          <Astro.self heading={subheading} />
        ))}
      </ul>
    )
  }
</li>
