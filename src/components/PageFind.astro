---
import Search from "astro-pagefind/components/Search";
---

<dialog
  data-pagefind-ignore
  id="search-dialog"
  aria-labelledby="search-title"
  class="border-border bg-bg text-ink m-auto w-[calc(100%-2rem)] max-w-xl rounded-xl border p-5 shadow-xl backdrop:bg-black/40 backdrop:backdrop-blur-sm"
>
  <div class="mb-4 flex items-center justify-between gap-4">
    <h2 id="search-title" class="text-lg font-semibold">Search the site</h2>
    <form method="dialog">
      <button class="text-muted hover:bg-surface rounded-md px-3 py-2 text-sm"
        >Close <span aria-hidden="true">×</span></button>
    </form>
  </div>
  <Search
    id="search"
    className="pagefind-ui"
    uiOptions={{ showImages: false, excerptLength: 20, resetStyles: false }}
  />
  <p class="text-muted mt-4 text-xs">
    Press Esc to close. Open search with / or ⌘ / Ctrl K.
  </p>
</dialog>
<script>
  let cleanup: (() => void) | undefined;
  function setupSearch() {
    cleanup?.();
    const dialog = document.getElementById(
      "search-dialog",
    ) as HTMLDialogElement | null;
    if (!dialog) return;
    const controller = new AbortController();
    const { signal } = controller;
    cleanup = () => {
      controller.abort();
      if (dialog.open) dialog.close();
    };
    function openSearch() {
      if (dialog!.open) return;
      dialog!.showModal();
      dialog!.querySelector<HTMLInputElement>("input")?.focus();
    }
    document
      .querySelectorAll("[data-search-open]")
      .forEach((button) =>
        button.addEventListener("click", openSearch, { signal }),
      );
    document.addEventListener(
      "keydown",
      (event) => {
        const target = event.target;
        const isEditing =
          target instanceof HTMLElement &&
          (target.isContentEditable ||
            !!target.closest("input, textarea, select, [contenteditable]"));
        if (isEditing) return;
        if (
          (event.key === "/" &&
            !event.metaKey &&
            !event.ctrlKey &&
            !event.altKey) ||
          ((event.metaKey || event.ctrlKey) && event.key.toLowerCase() === "k")
        ) {
          event.preventDefault();
          openSearch();
        }
      },
      { signal },
    );
    dialog.addEventListener(
      "click",
      (event) => {
        if (event.target !== dialog) return;
        const rect = dialog.getBoundingClientRect();
        if (
          event.clientX < rect.left ||
          event.clientX > rect.right ||
          event.clientY < rect.top ||
          event.clientY > rect.bottom
        )
          dialog.close();
      },
      { signal },
    );
    dialog.addEventListener(
      "click",
      (event) => {
        if (
          event.target instanceof Element &&
          event.target.closest(".pagefind-ui__result-link")
        )
          dialog.close();
      },
      { signal },
    );
  }
  document.addEventListener("astro:page-load", setupSearch);
  document.addEventListener("astro:before-swap", () => cleanup?.());
</script>
<style is:global>
  :root {
    --pagefind-ui-scale: 0.85;
    --pagefind-ui-border-width: 1px;
    --pagefind-ui-border-radius: 6px;
    --pagefind-ui-font: "Hanken Grotesk", sans-serif;
  }
  #search-dialog {
    max-height: 85dvh;
    --pagefind-ui-primary: var(--accent);
    --pagefind-ui-text: var(--body);
    --pagefind-ui-background: var(--bg);
    --pagefind-ui-border: var(--border);
    --pagefind-ui-tag: var(--surface);
  }
  #search input,
  #search p {
    font-weight: 400;
  }
  #search .pagefind-ui__result-title {
    font-weight: 600;
  }
</style>
